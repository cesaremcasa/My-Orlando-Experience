XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.20-0309-non-reasoning
ORLANDO_QUERY_TIMEOUT_SECONDS=30
ORLANDO_QUERY_MAX_CONCURRENCY=8
ORLANDO_AGENTOPS_DATA_DIR=./.agentops
ORLANDO_MEMORY_BACKEND=local
ORLANDO_AGENT_TIMEOUT_SECONDS=30
ORLANDO_AGENT_MAX_CONCURRENCY=8
ORLANDO_BETA_USERS=beta-001,beta-002,beta-003
ORLANDO_TRACE_CONTENT=0
ORLANDO_TRACE_EXPORTER=
PHOENIX_COLLECTOR_ENDPOINT=
ORLANDO_EVAL_BACKEND=local
ORLANDO_FAKE_RUNTIME=0
# Informational GCP identity. Local backends do not require these values.
# Billing is not enabled. Leave GOOGLE_CLOUD_AGENT_ENGINE_ID unset.
GOOGLE_CLOUD_PROJECT=orlando-506100
GOOGLE_CLOUD_LOCATION=us-central1
